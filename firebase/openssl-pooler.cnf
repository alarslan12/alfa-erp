# Supabase/Supavisor: temporary TLS compatibility workaround for database export.
# OpenSSL 3.5+ hybrid ML-KEM ClientHello can exceed 1024 bytes, which the
# pooler may reject as ESTARTUPPACKETTOOLARGE. Keep TLS 1.2+ enabled.
openssl_conf = alfa_erp_ssl

[alfa_erp_ssl]
ssl_conf = ssl_settings

[ssl_settings]
system_default = system_default_section

[system_default_section]
MinProtocol = TLSv1.2
Groups = X25519:P-256
