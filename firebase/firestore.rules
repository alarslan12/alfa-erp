rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Migration safety baseline: no anonymous ERP writes and no client writes to staging.
    // A production cutover must replace read-only business rules with reviewed
    // atomic order transitions and append-only idempotent operations.
    function signedIn() {
      return request.auth != null;
    }
    function memberPath(workspaceId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid);
    }
    function isMember(workspaceId) {
      return signedIn()
        && exists(memberPath(workspaceId))
        && get(memberPath(workspaceId)).data.active == true
        && get(memberPath(workspaceId)).data.role in ['admin', 'staff'];
    }
    function isAdmin(workspaceId) {
      return isMember(workspaceId)
        && get(memberPath(workspaceId)).data.role == 'admin';
    }

    match /workspaces/{workspaceId} {
      allow get: if isMember(workspaceId);
      allow list, create, update, delete: if false;

      match /members/{userId} {
        allow get: if signedIn()
          && (request.auth.uid == userId || isAdmin(workspaceId));
        allow list: if isAdmin(workspaceId);
        allow create, update, delete: if isAdmin(workspaceId);
      }

      match /books/{bookId} {
        allow get: if (resource.data.is_active == true) || isMember(workspaceId);
        allow list: if (resource.data.is_active == true) || isMember(workspaceId);
        allow create, update, delete: if false;
      }

      match /{collectionName}/{docId} {
        allow get, list: if isMember(workspaceId);
        // Intentionally read-only until concurrency and role rules are verified.
        allow create, update, delete: if false;
      }
    }

    match /migration_staging/{migrationId}/{document=**} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
